# Copy to .env and fill in the real values. Do not commit .env.

# Linear: Settings -> API -> Webhooks -> your webhook -> Signing secret
LINEAR_WEBHOOK_SECRET=

# PagerDuty: Integrations -> Generic Webhooks (v3) -> your subscription -> Signing secret
# One secret for each subscription.
PAGERDUTY_HIGH_PRIORITY_SECRET=
PAGERDUTY_LOW_PRIORITY_SECRET=

# The receipt printer on the local network.
PRINTER_IP=10.51.46.125
